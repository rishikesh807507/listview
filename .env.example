# ==============================================================================
# Listview Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Note: The platform runs out-of-the-box with SQLite and zero paid API keys.
# ==============================================================================

# --- Server Configuration ---
HOST=127.0.0.1
PORT=8000
DEBUG=False

# --- Database Connection ---
# SQLite default (zero-configuration):
DATABASE_URL=sqlite:///./market.db

# PostgreSQL alternative (optional for production deployments):
# DATABASE_URL=postgresql://listview_user:safe_password_placeholder@localhost:5432/listview_db

# --- Free & Community Data Providers ---
# Indian Stock Market Community API (MIT License)
INDIAN_STOCK_API_BASE=https://indian-stock-market-api.fly.dev

# IPO GMP Machine-Readable Feed (CC BY 4.0 License)
GMP_GITHUB_RAW_URL=https://raw.githubusercontent.com/Spectrumz00/india-ipo-gmp-data/main/data.json

# --- Cache Duration (Seconds) ---
CACHE_EXPIRY_SECONDS=300

# --- Frontend Client Configuration ---
# API endpoint base (defaults to Vite proxy '/api' during local dev)
VITE_API_BASE_URL=/api
